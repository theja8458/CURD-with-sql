<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=\, initial-scale=1.0">
    <title>Users</title>
    <style>
        table,tr,th,td{
         border: 1px solid black;
        }
    </style>
</head>
<body>
    <a href="/user/add">Add new User</a>
    <form method="get" action="/user/add"></form>
    <h1>All users</h1>
     <table>
        <tr>
            <th>Id</th>
            <th>Email</th>
            <th>Username</th>
        </tr>
        <% for(let user of users){%>
            <tr>
                <td> <%= user.id %></td>
                <td><%= user.email %></td>
                <td><%= user.username %></td>
                <td>
                <form method="GET" action="/user/<%= user.id %>/edit">
                    <button>Edit username</button>
                </form>
                </td>
                <td>
                    <form method="post" action="/user/<%= user.id %>?_method=DELETE">
                        <button>Delete user</button>
                    </form>
                    </td>
            </tr>
        <% }%>
     </table>
</body>
</html>

