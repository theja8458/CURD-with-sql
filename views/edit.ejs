<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit usernme</title>
</head>
<body>
    <h2>You are about to edit user: <%= user.email %></h2>
    <form method="post" action="/user/<%= user.id %>?_method=PATCH">
        <textarea name="username" id=""><%= user.email %></textarea><br>
        <input type="password" name="password" placeholder="Enter password">
        <button>Edit</button>
    </form>
    
</body>
</html>